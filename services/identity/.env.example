# services/identity — host form: services run on the host during development.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://wayfare:wayfare@localhost:5433/wayfare_identity?schema=public
DATABASE_URL_TEST=postgresql://wayfare:wayfare@localhost:5433/wayfare_identity_test?schema=public
DATABASE_URL_SHADOW=postgresql://wayfare:wayfare@localhost:5433/wayfare_identity_shadow?schema=public
NATS_URL=nats://localhost:4222
# Integration suites only: a separate broker, so test events never reach a running identity.
NATS_URL_TEST=nats://localhost:4223
GRPC_URL=0.0.0.0:50051
REDIS_URL=redis://localhost:6379
# Signing key: empty here; `pnpm keys:dev` writes both into .env.
JWT_PRIVATE_KEY=
JWT_KEY_ID=
# The first SUPER_ADMIN — read only by `pnpm bootstrap:super-admin`; set for the one run.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
OPS_PORT=3101
METRICS_PORT=9101
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SERVICE_NAME=identity
# Build identity for /version; the image stamps real values.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown
BUILT_AT=unknown
