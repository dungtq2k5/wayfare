# services/identity — host form: services run on the host during development.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://wayfare:wayfare@localhost:15433/wayfare_identity?schema=public
DATABASE_URL_TEST=postgresql://wayfare:wayfare@localhost:15433/wayfare_identity_test?schema=public
DATABASE_URL_SHADOW=postgresql://wayfare:wayfare@localhost:15433/wayfare_identity_shadow?schema=public
NATS_URL=nats://localhost:14222
# Integration suites only: a separate broker, so test events never reach a running identity.
NATS_URL_TEST=nats://localhost:14223
GRPC_URL=0.0.0.0:50051
REDIS_URL=redis://localhost:16379
# Signing key: empty here; `pnpm keys:dev` writes both into .env.
JWT_PRIVATE_KEY=
JWT_KEY_ID=
# The first SUPER_ADMIN — read only by `pnpm bootstrap:super-admin`; set for the one run.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# pnpm seed:dev only: the password of moderator@wayfare.test and tourist@wayfare.test; unset skips them.
SEED_ACCOUNT_PASSWORD=
# Transactional email (conventions §11.4): SMTP to Mailpit locally, restricted to test domains.
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Wayfare <no-reply@wayfare.local>
EMAIL_DELIVERY_MODE=restricted
EMAIL_NONPROD_ALLOWLIST=*@example.com,*@wayfare.local
EMAIL_NONPROD_CATCHALL=team@wayfare.local
# Written by `pnpm keys:dev` when absent.
EMAIL_HASH_KEY=
# The national ID key (AES-256-GCM, 32 bytes base64). Written by `pnpm keys:dev` when absent;
# replacing it makes every stored national ID unreadable.
PII_ENCRYPTION_KEY=
# Deployed only: a sending-only key and the webhook secret.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Read only by `pnpm email:check-domain`, a deploy step (a full-access key).
RESEND_ADMIN_API_KEY=
RESEND_DOMAIN_ID=
CONSOLE_URL=http://localhost:5173
WEB_URL=http://localhost:5174
OPS_PORT=3101
METRICS_PORT=9101
# billing's gRPC address: live obligations before an owner is deactivated.
BILLING_GRPC_URL=localhost:50054
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SERVICE_NAME=identity
# Build identity for /version; the image stamps real values.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown
BUILT_AT=unknown
