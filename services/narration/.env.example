# services/narration — host form: services run on the host during development.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://wayfare:wayfare@localhost:15435/wayfare_narration?schema=public
DATABASE_URL_TEST=postgresql://wayfare:wayfare@localhost:15435/wayfare_narration_test?schema=public
DATABASE_URL_SHADOW=postgresql://wayfare:wayfare@localhost:15435/wayfare_narration_shadow?schema=public
NATS_URL=nats://localhost:14222
# Integration suites only: a separate broker, so test events never reach a running narration.
NATS_URL_TEST=nats://localhost:14223
# BullMQ, and the socket emitter: the same Redis as the gateway's socket adapter.
REDIS_URL=redis://localhost:16379
GRPC_URL=0.0.0.0:20053
OPS_PORT=3103
METRICS_PORT=9103
CATALOG_GRPC_URL=localhost:20052
BILLING_GRPC_URL=localhost:20054
# Audio goes to the media bucket under audio/ (architecture §3.6).
GCS_BUCKET_MEDIA=wayfare-media-local
GCS_API_ENDPOINT=http://localhost:4443
GCS_PUBLIC_BASE_URL=http://localhost:4443/wayfare-media-local
# A throwaway signing key file: empty here; `pnpm keys:dev` writes the path. Unset in Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=
# Providers to try, in order (architecture §8): the fakes locally; e.g. google,free deployed.
TRANSLATION_PROVIDER_ORDER=fake
TTS_PROVIDER_ORDER=fake
# Required when an order names google.
GOOGLE_CLOUD_PROJECT=
# Optional: tasks at once per process (1 to 3), and fakes that fail every call (translation, speech).
SYNTHESIS_CONCURRENCY=
FAKE_PROVIDER_FAILURES=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SERVICE_NAME=narration
# Build identity for /version; the image stamps real values.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown
BUILT_AT=unknown
