# services/analytics — host form: services run on the host during development.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://wayfare:wayfare@localhost:15437/wayfare_analytics?schema=public
DATABASE_URL_TEST=postgresql://wayfare:wayfare@localhost:15437/wayfare_analytics_test?schema=public
DATABASE_URL_SHADOW=postgresql://wayfare:wayfare@localhost:15437/wayfare_analytics_shadow?schema=public
# BullMQ (the rollup jobs) and the heatmap's and the runtime lane's counters.
REDIS_URL=redis://localhost:16379
GRPC_URL=0.0.0.0:20055
# The scheduled jobs; `false` only on the screens' stack (infra/docker/compose.screens.yaml).
JOBS_ENABLED=true
OPS_PORT=3105
METRICS_PORT=9105
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SERVICE_NAME=analytics
# Build identity for /version; the image stamps real values.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown
BUILT_AT=unknown
