{
  "name": "@wayfare/analytics",
  "version": "0.0.0",
  "private": true,
  "description": "Consented events, the consent-free runtime lane and the dashboards' rollups (architecture §2, rdm-spec §3.5).",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev --skip-generate",
    "db:deploy": "prisma migrate deploy && pnpm db:objects",
    "db:setup": "pnpm db:deploy && PRISMA_DB=test pnpm db:deploy",
    "db:objects": "prisma db execute --file prisma/sql/schema-objects.sql",
    "db:verify": "wayfare-db-verify",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "job": "node dist/src/scripts/run-job.js",
    "seed:dev": "node dist/prisma/seed/dev-events.seed.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/microservices": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@wayfare/contracts": "workspace:*",
    "@wayfare/nest-common": "workspace:*",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@swc/cli": "^0.8.1",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.15.0",
    "@wayfare/config": "workspace:*",
    "prisma": "7.10.0"
  }
}
