{
  "name": "@wayfare/catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Places, their localizations and media, and the tourist read path (architecture §2).",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev --skip-generate",
    "db:deploy": "prisma migrate deploy && pnpm db:objects && pnpm db:seed:system",
    "db:setup": "pnpm db:deploy && PRISMA_DB=test pnpm db:deploy",
    "db:objects": "prisma db execute --file prisma/sql/schema-objects.sql",
    "db:seed:system": "echo 'catalog has no system rows; categories and areas are pilot content'",
    "db:verify": "wayfare-db-verify",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "storage:setup": "turbo run build --filter=@wayfare/catalog --output-logs=errors-only && node dist/src/scripts/storage-setup.js"
  },
  "dependencies": {
    "@google-cloud/storage": "8.1.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/microservices": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@wayfare/contracts": "workspace:*",
    "@wayfare/core": "workspace:*",
    "@wayfare/nest-common": "workspace:*",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@swc/cli": "^0.8.1",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@wayfare/config": "workspace:*",
    "prisma": "7.10.0"
  }
}
