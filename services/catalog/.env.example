# services/catalog — host form: services run on the host during development.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://wayfare:wayfare@localhost:5434/wayfare_catalog?schema=public
DATABASE_URL_TEST=postgresql://wayfare:wayfare@localhost:5434/wayfare_catalog_test?schema=public
DATABASE_URL_SHADOW=postgresql://wayfare:wayfare@localhost:5434/wayfare_catalog_shadow?schema=public
NATS_URL=nats://localhost:4222
# Integration suites only: a separate broker, so test events never reach a running catalog.
NATS_URL_TEST=nats://localhost:4223
# BullMQ, for the cleanup jobs.
REDIS_URL=redis://localhost:6379
GRPC_URL=0.0.0.0:50052
OPS_PORT=3102
METRICS_PORT=9102
# Media (architecture §3.6): the local emulator, a bucket `pnpm --filter @wayfare/catalog storage:setup` creates.
GCS_BUCKET_MEDIA=wayfare-media-local
GCS_API_ENDPOINT=http://localhost:4443
GCS_PUBLIC_BASE_URL=http://localhost:4443/wayfare-media-local
# A throwaway signing key file: empty here; `pnpm keys:dev` writes one and its path. Unset in Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SERVICE_NAME=catalog
# Build identity for /version; the image stamps real values.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown
BUILT_AT=unknown
