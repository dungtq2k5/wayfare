# services/billing — host form: services run on the host during development.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://wayfare:wayfare@localhost:5436/wayfare_billing?schema=public
DATABASE_URL_TEST=postgresql://wayfare:wayfare@localhost:5436/wayfare_billing_test?schema=public
DATABASE_URL_SHADOW=postgresql://wayfare:wayfare@localhost:5436/wayfare_billing_shadow?schema=public
NATS_URL=nats://localhost:4222
# Integration suites only: a separate broker, so test events never reach a running billing.
NATS_URL_TEST=nats://localhost:4223
# BullMQ (the webhook queue) and the invoice cache.
REDIS_URL=redis://localhost:6379
GRPC_URL=0.0.0.0:50054
OPS_PORT=3104
METRICS_PORT=9104
CATALOG_GRPC_URL=localhost:50052
# Checkout's success and cancel pages and the portal's return page.
CONSOLE_URL=http://localhost:5173
# Stripe (architecture §5): the mode comes from the key. Empty locally: the three Stripe-backed
# owner routes answer 503, everything else works. A sandbox's restricted key is rk_test_….
STRIPE_MODE=test
STRIPE_SECRET_KEY=
# Written by `pnpm keys:dev` when absent; `stripe listen`'s secret replaces it for a sandbox.
STRIPE_WEBHOOK_SECRET=
# Read only by `pnpm --filter @wayfare/billing seed:dev`, from `stripe:sandbox-setup`'s output:
# STRIPE_PRICE_GROWTH_MONTHLY=
# STRIPE_PRICE_GROWTH_ANNUAL=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SERVICE_NAME=billing
# Build identity for /version; the image stamps real values.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown
BUILT_AT=unknown
