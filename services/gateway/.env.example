# services/gateway — host form: services run on the host during development.
# No OPS_PORT: the ops routes ride the public PORT here.
NODE_ENV=development
LOG_LEVEL=info
PORT=13000
GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true
IDENTITY_GRPC_URL=localhost:50051
CATALOG_GRPC_URL=localhost:50052
NARRATION_GRPC_URL=localhost:50053
BILLING_GRPC_URL=localhost:50054
# The host printed on QR stickers (never changes once printed), and the universal-link host
# `/q/:code` redirects to. Locally the gateway itself and the web app.
PUBLIC_QR_BASE_URL=http://localhost:13000
PUBLIC_LINK_BASE_URL=http://localhost:5174
# Verification keys: empty here; `pnpm keys:dev` writes them into .env.
JWT_PUBLIC_KEYS=
REDIS_URL=redis://localhost:16379
METRICS_PORT=9100
MIN_SUPPORTED_APP_VERSION=0.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_SERVICE_NAME=gateway
# Build identity for /version; the image stamps real values.
APP_VERSION=0.0.0-dev
GIT_SHA=unknown
BUILT_AT=unknown
