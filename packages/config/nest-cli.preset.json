{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "builder": {
      "type": "swc",
      "options": {
        "filenames": ["src", "generated"],
        "ignore": ["**/*.spec.ts", "**/*.e2e-spec.ts"]
      }
    },
    "typeCheck": true
  },
  "entryFile": "src/main"
}
