{
  "name": "@wayfare/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The Android tourist app (ADR 0059).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "bundle:check": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "eas-build-post-install": "pnpm --filter @wayfare/mobile^... build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@wayfare/api-client": "workspace:*",
    "@wayfare/contracts": "workspace:*",
    "@wayfare/i18n": "workspace:*",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^12.1.2",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "3.4.19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "typescript": "~6.0.3"
  }
}
