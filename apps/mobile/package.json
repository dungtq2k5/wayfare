{
  "name": "@wayfare/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The Android tourist app (ADR 0059).",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_NO_TYPESCRIPT_SETUP=1 expo start --dev-client",
    "start": "EXPO_NO_TYPESCRIPT_SETUP=1 expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "bundle:check": "expo export --platform android --output-dir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "eas-build-post-install": "pnpm --filter @wayfare/mobile^... build",
    "brand": "node scripts/build-brand-assets.mjs",
    "markers": "node scripts/build-marker-images.mjs",
    "notification-artwork": "node scripts/build-notification-artwork.mjs"
  },
  "dependencies": {
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@tanstack/query-async-storage-persister": "^5.108.1",
    "@tanstack/react-query": "^5.108.1",
    "@tanstack/react-query-persist-client": "^5.108.1",
    "@wayfare/api-client": "workspace:*",
    "@wayfare/contracts": "workspace:*",
    "@wayfare/core": "workspace:*",
    "@wayfare/design-tokens": "workspace:*",
    "@wayfare/i18n": "workspace:*",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "fflate": "0.8.3",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.7.1",
    "intl-messageformat": "^12.2.0",
    "lucide-react-native": "^1.77.0",
    "nativewind": "4.2.7",
    "react": "19.3.1",
    "react-i18next": "^17.0.15",
    "react-native": "0.88.1",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.8.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-worklets": "0.14.0",
    "tailwindcss": "3.4.19",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@types/react": "~19.3.0",
    "@wayfare/ui": "workspace:*",
    "babel-preset-expo": "~57.0.13",
    "sharp": "0.35.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  }
}
