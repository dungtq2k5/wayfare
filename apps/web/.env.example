# The tourist web app (architecture §14). Every value has a local default in src/env.ts.
# Empty in a deployed environment: the web app's origin serves /api.
NEXT_PUBLIC_API_ORIGIN=http://localhost:13000
GATEWAY_INTERNAL_URL=http://localhost:13000
# The bucket's public origin, space-separated if more: the page's CSP lets the browser fetch
# photos, audio and map packs from it (server-only, read at start).
MEDIA_ORIGINS=http://localhost:4443
# The OAuth Web client (the gateway's GOOGLE_SERVER_CLIENT_ID); unset, Google's button is hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The Android app's Play Store page.
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.wayfare
