# The console (architecture §14). Every value has a local default in src/env.ts.
# Empty in a deployed environment: the console's origin serves /api and /ws.
NEXT_PUBLIC_API_ORIGIN=http://localhost:13000
GATEWAY_INTERNAL_URL=http://localhost:13000
# The OAuth Web client (the gateway's GOOGLE_SERVER_CLIENT_ID); unset, Google's button is hidden.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
