{
  "name": "@wayfare/console",
  "version": "0.1.0",
  "private": true,
  "description": "The console for staff and venue owners: Next.js, calling the gateway as a browser would (ADR 0060).",
  "scripts": {
    "dev": "next dev --port 5173",
    "build": "next build",
    "start": "next start --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "e2e": "playwright test --project=chromium",
    "test:screens": "E2E_SUITE=screens playwright test --project=screens",
    "test:screens:update": "E2E_SUITE=screens playwright test --project=screens --update-snapshots=all"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@wayfare/api-client": "workspace:*",
    "@wayfare/contracts": "workspace:*",
    "@wayfare/design-tokens": "workspace:*",
    "@wayfare/i18n": "workspace:*",
    "@wayfare/ui": "workspace:*",
    "intl-messageformat": "12.1.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "socket.io-client": "4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@wayfare/config": "workspace:*",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
