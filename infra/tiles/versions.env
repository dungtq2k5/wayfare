# Pinned inputs of `pnpm tiles:build` (architecture §6). Move a pin forward on purpose, then
# rebuild and register: see README.md.

# The pmtiles CLI (protomaps/go-pmtiles), downloaded into .cache/.
PMTILES_VERSION=1.31.2

# The Protomaps daily planet build the map is cut from. Protomaps removes old builds after a
# while; when this one is gone, pick a newer date from https://maps.protomaps.com/builds/.
PROTOMAPS_BUILD_DATE=20261003
PROTOMAPS_BUILD_URL=https://build.protomaps.com/${PROTOMAPS_BUILD_DATE}.pmtiles

# The style generator (the @protomaps/basemaps npm package) and the glyphs and sprites it expects
# (protomaps/basemaps-assets, pinned to a commit).
BASEMAPS_VERSION=5.7.2
BASEMAPS_ASSETS_COMMIT=028c18f713baecad011301ff7a69acc39bcc2ae7

# The style's flavour and label language.
BASEMAPS_FLAVOR=light
BASEMAPS_LANG=vi

# Zoom: from 10 up to the pinned build's maximum; clients overzoom beyond it.
MIN_ZOOM=10
MAX_ZOOM=15
