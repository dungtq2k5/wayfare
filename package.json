{
  "name": "wayfare",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^24.14.0"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint eslint.config.mjs vitest.config.mts vitest.setup.ts",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run db:generate && vitest run --project 'unit:*'",
    "test:coverage": "vitest run --project unit:core --coverage",
    "sonar": "set -a && . ./.env.sonar && set +a && pnpm test:coverage && npx @sonar/scan",
    "test:integration": "turbo run db:generate && vitest run --project 'integration:*'",
    "db:generate": "turbo run db:generate",
    "db:deploy": "turbo run db:deploy --concurrency=1",
    "db:setup": "turbo run db:setup --concurrency=1",
    "db:objects": "turbo run db:objects --concurrency=1",
    "db:verify": "turbo run db:verify --concurrency=1",
    "db:drift": "turbo run db:drift --concurrency=1",
    "seed:dev": "turbo run seed:dev --concurrency=1",
    "keys:dev": "node packages/config/scripts/generate-dev-keys.mjs",
    "proto:generate": "pnpm --filter @wayfare/contracts proto:generate",
    "proto:lint": "pnpm --filter @wayfare/contracts proto:lint",
    "proto:breaking": "pnpm --filter @wayfare/contracts proto:breaking",
    "api:generate": "OPENAPI_WRITE=1 vitest run --project unit:gateway test/e2e/openapi-emit && pnpm --filter @wayfare/api-client generate",
    "mobile:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:13000 tcp:13000 && adb reverse tcp:4443 tcp:4443",
    "tiles:build": "bash infra/tiles/build.sh",
    "recover:narration": "bash services/gateway/scripts/recover-narration.sh",
    "walks": "bash services/gateway/scripts/walks.sh",
    "verify:spine": "node services/gateway/scripts/verify-spine.mjs",
    "closing-run": "bash services/gateway/scripts/closing-run.sh",
    "prepare": "simple-git-hooks",
    "i18n:types": "I18N_TYPES_WRITE=1 vitest run --project unit:i18n generated-types"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "11.2.5",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "4.1.11",
    "@wayfare/config": "workspace:*",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "^3.9.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1",
    "preserveUnused": [
      "post-checkout",
      "post-commit"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,yaml,yml,css}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.md": [
      "markdownlint-cli2 --fix --no-globs"
    ]
  }
}
