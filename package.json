{
  "name": "wayfare",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.14.0"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint eslint.config.mjs vitest.config.mts vitest.setup.ts",
    "lint:md": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run db:generate && vitest run --project 'unit:*'",
    "test:coverage": "vitest run --project unit:core --coverage",
    "test:integration": "turbo run db:generate && vitest run --project 'integration:*'",
    "db:generate": "turbo run db:generate",
    "db:deploy": "turbo run db:deploy --concurrency=1",
    "db:setup": "turbo run db:setup --concurrency=1",
    "db:objects": "turbo run db:objects --concurrency=1",
    "db:verify": "turbo run db:verify --concurrency=1",
    "db:drift": "turbo run db:drift --concurrency=1",
    "seed:dev": "turbo run seed:dev --concurrency=1",
    "keys:dev": "node packages/config/scripts/generate-dev-keys.mjs",
    "proto:generate": "pnpm --filter @wayfare/contracts proto:generate",
    "proto:lint": "pnpm --filter @wayfare/contracts proto:lint",
    "proto:breaking": "pnpm --filter @wayfare/contracts proto:breaking",
    "tiles:build": "bash infra/tiles/build.sh",
    "recover:narration": "bash services/gateway/scripts/recover-narration.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "11.2.5",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "4.1.11",
    "@wayfare/config": "workspace:*",
    "eslint": "^9.39.5",
    "globals": "^16.0.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "^3.9.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "turbo": "^2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  }
}
